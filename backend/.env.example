# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql://postgres:password@localhost:5432/ar_management_db

# AWS Bedrock Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_SESSION_TOKEN=

# Model ID: Amazon Nova Pro
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
USE_MOCK_BEDROCK_FALLBACK=false

# Email Delivery Settings (SMTP / Simulated)
EMAIL_PROVIDER=simulated
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=ar-agent@fintech-enterprise.com
FROM_NAME=ReceivIQ

# Accounts Receivable Business Policy Rules
PENALTY_RATE_PERCENT=2.0
PENALTY_DAYS_CYCLE=30
ESCALATION_OVERDUE_DAYS_THRESHOLD=30
MAX_REMINDERS_BEFORE_ESCALATION=3
HIGH_VALUE_APPROVAL_THRESHOLD=100000.0

# Chat Limits & Token Controls
CHAT_MAX_HISTORY_TURNS=10
CHAT_MAX_CHARS=1000
CHAT_DAILY_CREDITS=50
CHAT_SESSION_CREDITS=15
AUTOMATION_INTERVAL_MINUTES=15
